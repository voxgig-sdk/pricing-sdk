# Entity: pricing

main: kit: entity: pricing: {

  alias: field: {}

  fields: [
    {
      name: "attribution"
      req: true
      short: "Ready-to-paste Markdown attribution with both links already embedded (brand -> links.home, \"{product} pricing\" -> links.page)."
      type: "`$STRING`"
    }
    {
      name: "category"
      req: false
      type: "`$STRING`"
    }
    {
      name: "discounts"
      req: false
